# Copy to .env.local and fill in. See docs/decisions.md D10 for local-vs-hosted Supabase.
#
# Local development: run `supabase start`, then copy the printed api_url / anon key /
# service_role key from its output (or `supabase status`) into the three Supabase values below.
#
# Hosted (Ubunye-owned) project: use the values from the project's Settings > API page.
# Never commit real values for SUPABASE_SERVICE_ROLE_KEY or ANTHROPIC_API_KEY.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI service (spec §36). "mock" (default) needs no key and never calls out to a model —
# every recommendation/explanation still works. Set to "claude" only once you want live,
# natural-language skill interpretation, and provide ANTHROPIC_API_KEY server-side only.
NEXT_PUBLIC_AI_MODE=mock
ANTHROPIC_API_KEY=

# Demo control panel (spec §31, docs/decisions.md D4). Never "true" on a deployment that
# carries real user data — it allows a full database reset/reseed via the service-role key.
ENABLE_DEMO_PANEL=false
